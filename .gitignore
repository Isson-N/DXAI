training/run_aldan_*.sh

# Материалы организатора (лекции, расшифровки)
data/*.txt

# Ручная разметка (производная от данных организатора)
# Разметка версионируется: UID исследований, по подтверждению организатора,
# случайные и пациентов не идентифицируют. Резервные копии — мимо git.
data/annotations/*.bak-*
data/annotations/*.backup-*
data/annotations/*.legacy-*

# Предсказания на уровне снимков — производные от данных организатора
experiments/results/*/oof.csv
experiments/results/**/oof.csv

# Пофайловые предсказания и веса: содержат UID исследований организатора / производны от его данных
experiments/results/**/oof_*.csv
models/*
